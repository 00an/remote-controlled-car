# MongoDB Atlas
# Get the connection string from Atlas: Database -> Connect -> Drivers -> Python
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=nl14
MONGO_COLLECTION=control_inputs
# Optional — defaults to controller_broadcasts. The backend writes raw broadcast
# frames here (one per WebSocket message to the ESP32); the dashboard's
# "Raw vs Logged" tab compares this against MONGO_COLLECTION.
MONGO_BROADCAST_COLLECTION=controller_broadcasts
